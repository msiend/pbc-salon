PORT=3000
# Use Node 24's --env-file=.env option; no credentials are committed.
ADMIN_PASSWORD=
SESSION_SECRET=
DB_PATH=./data/salon.sqlite
# Numeric Pixel ID; optional. Visitors must consent before events fire.
META_PIXEL_ID=
# Set production only behind HTTPS. Set TRUST_PROXY=1 only behind one trusted proxy.
NODE_ENV=development
# TRUST_PROXY=1
# Add a licensed audio file as public/music/song.mp3 to enable the player.
MUSIC_TITLE=A little nostalgia

# WhatsApp Cloud API: required together for automatic coupon confirmations.
# Store the token securely; never commit .env or share the token in chat.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=salon_coupon_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
# Your real HTTPS website origin, e.g. https://salon.example.com (no path).
PUBLIC_BASE_URL=
