<%
const pages={overview:['Overview','A little clarity for your salon day.'],leads:['Customer leads','Find a customer, check a coupon, and manage their visit.'],services:['Services & prices','Keep your service menu up to date.'],offers:['Promotional offers','Manage the offers customers see on your website.'],settings:['Settings & branding','Make your salon experience feel like you.']};
const [title,subtitle]=pages[section];
const campaignOpen=counts.total<100 && offers.some(offer=>offer.active);
%>
<%- include('admin/head',{title,login:false}) %>
<div class="admin-shell">
  <aside class="admin-sidebar" aria-label="Salon management">
    <a class="admin-brand" href="/admin" aria-label="Raju Reyaz admin overview"><%- include('brand') %></a>
    <span class="workspace-label">SALON WORKSPACE</span>
    <nav class="admin-nav" aria-label="Admin navigation">
      <% Object.entries(pages).forEach(([key,page])=>{ %>
        <a href="/admin<%= key==='overview'?'':'?section='+key %>" <%- section===key?'aria-current="page"':'' %>><%- include('admin/icon',{name:key}) %><span><%= key==='services'?'Services':key==='settings'?'Settings':key==='offers'?'Offers':page[0] %></span><% if(key==='leads'){ %><small><%= counts.total %></small><% } %></a>
      <% }); %>
    </nav>
    <div class="sidebar-bottom">
      <div class="workspace-location"><span class="location-mark">RR</span><div><strong>Nagaon salon</strong><small>Daccapatty · Assam</small></div></div>
      <a href="/" class="sidebar-external"><%- include('admin/icon',{name:'external'}) %>View website</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="sidebar-external" type="submit"><%- include('admin/icon',{name:'logout'}) %>Sign out</button></form>
    </div>
  </aside>
  <div class="admin-workspace">
    <header class="admin-topbar"><span>Workspace <span class="breadcrumb-divider">/</span> <strong><%= title %></strong></span><div class="admin-account"><span class="account-avatar">A</span><span>Administrator</span></div></header>
    <main id="admin-main" class="admin-main">
      <div class="admin-page-heading"><div><span class="admin-eyebrow">RAJU REYAZ · SALON MANAGEMENT</span><h1><%= title %></h1><p><%= subtitle %></p></div><% if(['overview','leads'].includes(section)){ %><a class="button outline" href="/admin/export"><%- include('admin/icon',{name:'download'}) %>Export all leads</a><% }else{ %><a class="admin-text-link" href="<%= section==='services'?'/#services':section==='offers'?'/offers':'/links' %>">View on website <%- include('admin/icon',{name:'external'}) %></a><% } %></div>
      <% if(flash){ %><div class="admin-notice success" role="status"><%- include('admin/icon',{name:'check'}) %><span><%= flash %></span></div><% } %>
      <% if(section==='overview'){ %>
        <div class="metric-grid">
          <% [['leads','Total claims',counts.total,'Of 100 welcome coupons'],['offers','Available coupons',counts.available,'Unused and within validity'],['check','Redeemed coupons',counts.used,'Marked as used'],['clock','Last 24 hours',stats.recent,'New customer applications']].forEach(([icon,label,value,note])=>{ %>
          <article class="metric-card"><div><span><%= label %></span><span class="metric-icon"><%- include('admin/icon',{name:icon}) %></span></div><strong><%= value %></strong><small><%= note %></small></article>
          <% }); %>
        </div>
        <div class="overview-grid">
          <section class="admin-card campaign-card"><div class="card-heading"><div><span class="admin-eyebrow">WELCOME CAMPAIGN</span><h2>A warm welcome. A little reward.</h2></div><span class="admin-badge <%= campaignOpen?'green':'neutral' %>"><%= counts.total>=100?'Fully claimed':campaignOpen?'Open for claims':'No active offers' %></span></div><p>Customers spin to reveal ₹100–₹150 off their visit.</p><div class="allocation-label"><strong><%= Math.max(0,100-counts.total) %> coupons remaining</strong><span><%= counts.total %> / 100 claimed</span></div><progress value="<%= Math.min(counts.total,100) %>" max="100" aria-label="Welcome coupons claimed"><%= counts.total %> of 100</progress><div class="campaign-footer"><span><%= settings.validity %>-day validity for new claims</span><a href="/admin?section=settings">Manage settings <%- include('admin/icon',{name:'arrow'}) %></a></div></section>
          <section class="admin-card daily-card"><span class="admin-eyebrow"><%= date(now) %> · IST</span><h2>Your day, at a glance</h2><div class="daily-line"><span>Preferred visits today</span><strong><%= counts.visitsToday %></strong></div><div class="daily-line"><span>Expired, unused coupons</span><strong><%= counts.expired %></strong></div><p>Preferred dates are customer requests, not confirmed appointments.</p><a class="admin-text-link" href="/admin?section=leads">Review customer leads <%- include('admin/icon',{name:'arrow'}) %></a></section>
        </div>
        <%- include('admin/leads',{overview:true}) %>
      <% }else if(section==='leads'){ %>
        <%- include('admin/leads',{overview:false}) %>
      <% }else if(section==='services'){ %>
        <div class="admin-notice"><%- include('admin/icon',{name:'services'}) %><span>Prices appear on your public service menu. Leave a price blank to display “Ask us for pricing”.</span></div>
        <section class="admin-card service-management"><div class="card-heading"><h2>Your service menu</h2><span class="admin-badge neutral"><%= services.length %> services</span></div>
          <% services.forEach((s,index)=>{ %><form class="admin-service-row" method="post" action="/admin/service/<%= s.id %>" data-admin-save><input type="hidden" name="csrf" value="<%= csrf %>"><span class="service-index"><%= String(index+1).padStart(2,'0') %></span><div class="service-description"><h3><%= s.name %></h3><p><%= s.description %></p></div><label>Price (₹)<input type="number" name="price" min="0" max="100000" step="1" value="<%= s.price??'' %>" placeholder="On request" aria-label="<%= s.name %> price in rupees"></label><button class="button outline" type="submit" aria-label="Save <%= s.name %> price">Save price</button></form><% }); %>
        </section>
      <% }else if(section==='offers'){ %>
        <div class="admin-notice"><%- include('admin/icon',{name:'offers'}) %><span>Active offers appear on the website. Turning an offer off stops new claims for that offer; existing coupons remain valid.</span></div>
        <div class="offer-management-grid">
          <% offers.forEach(o=>{ %><section class="admin-card"><div class="card-heading"><h2>Edit offer</h2><span class="admin-badge <%= o.active?'green':'neutral' %>"><%= o.active?'Active':'Hidden' %></span></div><%- include('admin/offer-form',{offer:o}) %></section><% }); %>
          <section class="admin-card new-offer-card"><div class="card-heading"><div><span class="admin-eyebrow">SOMETHING NEW</span><h2>Create an offer</h2></div><span class="metric-icon"><%- include('admin/icon',{name:'offers'}) %></span></div><%- include('admin/offer-form',{offer:{id:'',title:'',description:'',active:1}}) %></section>
        </div>
      <% }else if(section==='settings'){ %>
        <div class="settings-grid">
          <section class="admin-card"><div class="card-heading"><div><span class="admin-eyebrow">COUPONS</span><h2>Welcome offer settings</h2></div><%- include('admin/icon',{name:'offers'}) %></div><div class="settings-facts"><div><span>Random reward</span><strong>₹100–₹150</strong></div><div><span>Total allocation</span><strong>100 customers</strong></div></div><form method="post" action="/admin/settings" data-admin-save><input type="hidden" name="csrf" value="<%= csrf %>"><label for="validity">Coupon validity (days)</label><input id="validity" type="number" name="validity" value="<%= settings.validity %>" min="1" max="90" required aria-describedby="validity-help"><p class="field-help" id="validity-help">1–90 days. Applies to new claims only. Existing coupons keep their original amount and expiry.</p><button class="button" type="submit">Save settings</button></form></section>
          <section class="admin-card"><div class="card-heading"><div><span class="admin-eyebrow">BRAND IDENTITY</span><h2>Salon logo</h2></div><%- include('admin/icon',{name:'upload'}) %></div><div class="admin-logo-preview"><%- include('brand') %></div><p class="field-help"><%= logo?'Your current logo appears on the website and coupon downloads.':'Upload your original logo to replace this text branding.' %></p><form id="logo-upload"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Choose your logo<input type="file" name="logo" accept="image/png,image/jpeg,image/webp" required aria-describedby="logo-help"></label><p class="field-help" id="logo-help">PNG, JPG or WebP · Up to 5 MB. Your original is retained; surrounding white margins are trimmed on the display copy.</p><button class="button" type="submit">Upload logo</button><p id="logo-upload-status" role="status" class="field-help"></p></form></section>
          <section class="admin-card integration-card"><div class="card-heading"><div><span class="admin-eyebrow">CUSTOMER MESSAGING</span><h2>WhatsApp integration</h2></div><span class="admin-badge <%= whatsappConfigured?'green':'amber' %>"><%= whatsappConfigured?'Configured':'Setup needed' %></span></div><p><%= whatsappConfigured?'New claims are passed to your existing WhatsApp sender. Check each message status in Customer leads.':'WhatsApp is not configured. Customer confirmations remain queued until the server integration is configured.' %></p><p class="field-help">“Accepted” means Meta accepted the request; it does not confirm delivery. Check requests marked “Unknown” in Meta before resending.</p><a class="admin-text-link" href="/admin?section=leads">View message statuses <%- include('admin/icon',{name:'arrow'}) %></a></section>
        </div>
      <% } %>
      <footer class="admin-footer"><span>Raju Reyaz Unisex Salon · Nagaon</span><span>Dates & times shown in IST</span></footer>
    </main>
  </div>
</div>
<%- include('admin/end') %>
