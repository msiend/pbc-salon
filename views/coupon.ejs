<%- include('header') %>
<section class="section coupon-page" data-lead-success="<%= fresh?'yes':'no' %>" data-spin-value="<%= lead.discount %>" data-new-spin="<%= fresh&&lead.award_kind==='spin'?'yes':'no' %>">
 <div id="spin-stage" class="spin-stage" hidden><span class="eyebrow">A LITTLE SURPRISE, JUST FOR YOU</span><h1>Your reward<br>is on its way.</h1><div class="number-machine" aria-hidden="true"><span>₹</span><div class="number-window"><strong id="spin-number">100</strong></div></div><p role="status" aria-live="polite">Revealing your welcome discount…</p></div>
 <div id="coupon-result"><div class="result-heading"><span class="success-icon"><%- include('icon',{name:'check'}) %></span><span class="eyebrow">A LITTLE LUXURY, RESERVED FOR YOU</span><h1><%= lead.award_kind==='spin'?'Congratulations!':'Your welcome coupon.' %></h1><p><%= lead.award_kind==='spin'?"You've won ₹"+lead.discount+' off your visit.':'Your coupon is ready to download.' %></p></div>
 <article class="golden-coupon"><div class="coupon-brand"><%- include('brand') %></div><span class="coupon-kicker"><%= lead.award_kind==='spin'?'YOUR EXCLUSIVE REWARD':'YOUR WELCOME OFFER' %></span><div class="award-amount">₹<%= lead.discount %><small>OFF</small></div><p class="coupon-recipient">Made for <strong><%= lead.name %></strong></p><div class="coupon-code"><%= lead.code %></div><div class="coupon-meta"><div><span>VALID UNTIL</span><strong><%= date(lead.expires_at) %></strong></div><% if(lead.preferred_visit_date){ %><div><span>PREFERRED VISIT</span><strong><%= visitDate(lead.preferred_visit_date) %></strong></div><% } %></div><% if(lead.used||lead.expires_at<Date.now()){ %><p class="status"><%= lead.used?'This coupon has been used.':'This coupon has expired.' %></p><% } %><div class="coupon-bottom"><strong>Haque Market, Daccapatty, Nagaon · 9126691868</strong><p>Eligible services only. Single use. No cash value. Discount cannot exceed the bill. Cannot be combined with other offers. Terms apply.</p></div></article>
 <div class="actions center-actions"><a class="button" href="/coupon/<%= lead.token %>/download" download><%- include('icon',{name:'download'}) %> Download PNG</a><button class="button outline" data-share data-url="/claim">Share the offer <%- include('icon',{name:'arrow'}) %></button></div><p class="result-note">Save it to your phone and show it at the salon.<br>Keep your personalised coupon and its link private.</p><a class="text-link" href="tel:+919126691868" data-contact>Plan your visit · Call the salon</a>
 </div>
</section><%- include('footer') %>
